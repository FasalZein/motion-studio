{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/FasalZein/motion-studio/cli/schema/taste.schema.json",
  "title": "motion-studio taste profile, ~/.motion-studio/taste.json, version 1",
  "type": "object",
  "required": ["version", "liked", "rejected", "notes"],
  "properties": {
    "version": {"const": 1},
    "liked": {"type": "array", "items": {"$ref": "#/definitions/entry"}},
    "rejected": {"type": "array", "items": {"$ref": "#/definitions/entry"}},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "terms", "date"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "date": {"$ref": "#/definitions/date"},
          "film": {"type": "string", "minLength": 1},
          "gate": {"enum": ["G1", "G2", "G3", "G4", "G5"]}
        }
      }
    }
  },
  "definitions": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entry": {
      "type": "object",
      "required": ["kind", "value", "note", "date"],
      "properties": {
        "kind": {"enum": ["look", "move", "pacing"]},
        "value": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/definitions/date"}
      }
    }
  }
}
